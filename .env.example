# ==============================================================================
# Rhymance Monorepo Environment Variables Template
# ==============================================================================
# Copy this file to '.env' inside respective packages or root where needed.
# Do NOT commit raw API keys or production secrets to Git.

# ------------------------------------------------------------------------------
# Firebase Frontend Client Configurations (apps/app & apps/marketing)
# ------------------------------------------------------------------------------

# Enables connection to the local Firebase Emulator Suite.
# Set to 'true' for local development, 'false' for production.
EXPO_PUBLIC_USE_EMULATORS=true

# Firebase Web App configurations retrieved from the Firebase Console.
EXPO_PUBLIC_FIREBASE_API_KEY=mock-api-key-for-local-emulator
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rhymance-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rhymance-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=rhymance-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# Cloud Functions Environment Mappings (firebase/functions)
# ------------------------------------------------------------------------------

# Port configuration for functions runner
PORT=5001

# Administrative claims override token (used in tests only)
ADMIN_SECRET_KEY=mock-admin-development-secret-token
