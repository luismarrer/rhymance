rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthed() {
      return request.auth != null;
    }

    // Helper to check ownership
    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // Helper to check custom claims role
    function hasRole(role) {
      return isAuthed() && request.auth.token.role == role;
    }

    // Helper to check if a block exists between two users
    function isNotBlocked(userA, userB) {
      return !exists(/databases/$(database)/documents/blocks/$(userA + '_' + userB))
          && !exists(/databases/$(database)/documents/blocks/$(userB + '_' + userA));
    }

    // 1. User records
    match /users/{userId} {
      allow read: if isAuthed() && (request.auth.uid == userId || hasRole('admin') || hasRole('moderator'));
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdAt']);
      allow delete: if isAuthed() && request.auth.uid == userId;
    }

    // 2. Profiles
    match /profiles/{userId} {
      allow read: if isAuthed() && isNotBlocked(request.auth.uid, userId);
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId;
      allow delete: if isAuthed() && request.auth.uid == userId;
    }

    // 3. Poems
    match /poems/{poemId} {
      allow read: if isAuthed() && (resource.data.moderationStatus == 'approved' || resource.data.authorId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthed() && resource.data.authorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'createdAt']);
      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;
    }

    // 4. Swipes (Client can write, but never read other swipes directly)
    match /swipes/{swipeId} {
      allow read: if false; // Only Cloud Functions matchmaker reads swipes
      allow create: if isAuthed() && request.resource.data.swiperId == request.auth.uid;
    }

    // 5. Matches
    match /matches/{matchId} {
      allow read: if isAuthed() && request.auth.uid in resource.data.users;
      allow write: if false; // Matches are created only by Cloud Functions / transactions
    }

    // 6. Conversations & Messages
    match /conversations/{matchId} {
      allow read: if isAuthed() && request.auth.uid in resource.data.participants;
      allow write: if isAuthed() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthed() && request.auth.uid in get(/databases/$(database)/documents/conversations/{matchId}).data.participants;
        allow create: if isAuthed() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/{matchId}).data.participants;
      }
    }

    // 7. Blocks
    match /blocks/{blockId} {
      allow read: if isAuthed() && (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);
      allow create: if isAuthed() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.blockerId == request.auth.uid;
    }

    // 8. Reports
    match /reports/{reportId} {
      allow read: if isAuthed() && (request.auth.uid == resource.data.reporterId || hasRole('admin') || hasRole('moderator'));
      allow create: if isAuthed() && request.resource.data.reporterId == request.auth.uid;
    }
  }
}
